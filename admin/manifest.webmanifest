{
  "name": "GDprint Admin Panel",
  "short_name": "GDprint Admin",
  "description": "GDprint ադմին և մենեջերների կառավարման վահանակ",
  "id": "./login.html",
  "start_url": "./login.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0b0b0d",
  "theme_color": "#0b0b0d",
  "orientation": "any",
  "icons": [
    {"src": "icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
